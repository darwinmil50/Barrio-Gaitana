# Copiar a .env. Ninguna variable contiene secretos.
GAITAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GAITAN_OSM_API_URL=https://api.openstreetmap.org/api/0.6/map
GAITAN_OVERPASS_URL=https://overpass-api.de/api/interpreter
GAITAN_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GAITAN_CAMERAS_URL=
GAITAN_CACHE_TTL_SECONDS=900
GAITAN_REQUESTS_PER_MINUTE=60
GAITAN_HTTP_TIMEOUT_SECONDS=20
GAITAN_LOG_LEVEL=INFO
