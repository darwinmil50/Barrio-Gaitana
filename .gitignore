node_modules/
build/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Pruebas de navegador y reportes
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Archivos privados (se conservan las plantillas example)
.env
.env.*
!.env.example

# Temporales y del sistema operativo
*.tmp
*.temp
*.swp
*.swo
*~
*.log
.DS_Store
Thumbs.db
desktop.ini

# Repositorios anidados: este proyecto debe ser un único repositorio
